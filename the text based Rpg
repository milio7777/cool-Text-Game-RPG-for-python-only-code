def clr(): print("\n" * 30)
def bar(v, m, w=14):
    f = max(0, int(v / m * w))
    return "[" + "#"*f + "-"*(w-f) + "]"
def pause(t="  >> [Enter]"): input(t)
def box(title, w=24):
    pad = max(0,(w-len(title))//2)
    print("+" + "-"*(w-2) + "+")
    print("|" + " "*pad + title + " "*(w-2-pad-len(title)) + "|")
    print("+" + "-"*(w-2) + "+")
def hline(w=24): print("~"*w)

def show_credits():
    clr(); box("CREDITS",24); print()
    print("  Programmierer:"); print("  - Emilio"); print()
    print("  Tester:"); print("  - Martin"); print("  - (Emilio)"); print()
    print("  Danke fuers Spielen!"); print(); hline(); pause()

