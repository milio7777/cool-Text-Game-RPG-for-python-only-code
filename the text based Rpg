def abil_feuerball(p, mhp, bs):
    cost = max(4, 8 - (2 if p.get("subclass")=="feuermagier" else 0))
    if p["res"] < cost: return mhp, "  Zu wenig MP!", bs
    p["res"] -= cost
    mult = 1.4 if p.get("subclass")=="feuermagier" else 1.0
    dmg = int((p["atk"] * 1.5 + random.randint(3,8)) * mult)
    print(A_FEUERBALL)
    return mhp-dmg, f"  ~~FEUERBALL! -{dmg}~~", bs

def abil_heal(p, mhp, bs):
    cost = 3
    if p["res"] < cost: return mhp, "  Zu wenig MP!", bs
    p["res"] -= cost
    bonus = 8 if p.get("subclass")=="heiler" else 0
    h = random.randint(8,14) + bonus
    p["hp"] = min(p["mhp"], p["hp"]+h)
    print(A_HEAL)
    return mhp, f"  +Heal +{h} HP", bs

def abil_greaterheal(p, mhp, bs):
    cost = 6
    if p["res"] < cost: return mhp, "  Zu wenig MP!", bs
    p["res"] -= cost
    bonus = 15 if p.get("subclass")=="heiler" else 0
    h = random.randint(20,30) + bonus
    p["hp"] = min(p["mhp"], p["hp"]+h)
    print(A_GREATERHEAL)
    return mhp, f"  +++GREATER HEAL +{h}!!!+++", bs

def abil_thundershock(p, mhp, bs):
    cost = max(6, 10 - (2 if p.get("subclass")=="blitzmagier" else 0))
    if p["res"] < cost: return mhp, "  Zu wenig MP!", bs
    p["res"] -= cost
    dmg = int(p["atk"] * 1.3 + random.randint(2,6))
    stun_ch = 0.50 if p.get("subclass")=="blitzmagier" else 0.20
    stunned = random.random() < stun_ch
    if stunned: bs["stun"] = 1
    print(A_THUNDER)
    msg = f"  THUNDERSHOCK -{dmg}!" + (" BETAEUBT!" if stunned else "")
    return mhp-dmg, msg, bs

